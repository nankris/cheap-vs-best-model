index 7e4278f..1b578d4 100644
--- a/codec.py
+++ b/codec.py
@@ -1,3 +1,17 @@
 import json
+
+
 def decode(payload):
-    return payload.split(",")
+    """Decode a JSON array of undirected string edges."""
+    rows = json.loads(payload)
+    if not isinstance(rows, list):
+        raise ValueError("payload must be a JSON array of edges")
+
+    for edge in rows:
+        if (
+            not isinstance(edge, list)
+            or len(edge) != 2
+            or not all(isinstance(node, str) for node in edge)
+        ):
+            raise ValueError("each edge must be a pair of strings")
+    return rows
diff --git a/core.py b/core.py
index 58be593..e0dff85 100644
--- a/core.py
+++ b/core.py
@@ -1,2 +1,26 @@
 def solve(rows):
-    return rows[0] if rows else 0
+    """Return the lexicographically sorted connected components of rows."""
+    neighbors = {}
+    for left, right in rows:
+        neighbors.setdefault(left, set()).add(right)
+        neighbors.setdefault(right, set()).add(left)
+
+    components = []
+    unseen = set(neighbors)
+    while unseen:
+        start = min(unseen)
+        stack = [start]
+        unseen.remove(start)
+        component = []
+
+        while stack:
+            node = stack.pop()
+            component.append(node)
+            for neighbor in neighbors[node]:
+                if neighbor in unseen:
+                    unseen.remove(neighbor)
+                    stack.append(neighbor)
+
+        components.append(sorted(component))
+
+    return sorted(components)
