diff --git a/core.py b/core.py
index 4f39b98..0c0fa1d 100644
--- a/core.py
+++ b/core.py
@@ -1,2 +1,22 @@
-def solve(rows):
-    return sum(float(x) for x in rows)
+from dataclasses import dataclass
+from decimal import Decimal, ROUND_HALF_EVEN, localcontext
+
+
+@dataclass(frozen=True)
+class Money:
+    cents: int
+
+    @classmethod
+    def parse(cls, decimal_string: str) -> "Money":
+        amount = Decimal(decimal_string)
+        with localcontext() as context:
+            context.prec = max(context.prec, amount.adjusted() + 3, 2)
+            rounded = amount.quantize(Decimal("0.01"), rounding=ROUND_HALF_EVEN)
+        parts = rounded.as_tuple()
+        cents = int("".join(str(digit) for digit in parts.digits) or "0")
+        return cls(-cents if parts.sign else cents)
+
+    def __add__(self, other: "Money") -> "Money":
+        if not isinstance(other, Money):
+            return NotImplemented
+        return Money(self.cents + other.cents)
diff --git a/render.py b/render.py
index 80aac64..b4b89b3 100644
--- a/render.py
+++ b/render.py
@@ -1,2 +1,7 @@
-def present(value):
-    return str(value)
+from core import Money
+
+
+def present(value: Money) -> str:
+    sign = "-" if value.cents < 0 else ""
+    dollars, cents = divmod(abs(value.cents), 100)
+    return f"{sign}{dollars}.{cents:02d}"
